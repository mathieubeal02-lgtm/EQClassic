<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared contracts are compiled for the server (net10.0) and for the Unity client:
    LanternUnityTools needs Unity 2021.3, whose scripting runtime loads netstandard2.1 libraries.
    Keep this project free of APIs newer than netstandard2.1 (see Polyfills/).
  -->
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="2.1.4" />
  </ItemGroup>

</Project>
